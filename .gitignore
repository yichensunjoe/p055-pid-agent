# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Runtime data
data/
logs/
!backend/agentcad/data/
!backend/agentcad/data/*.json
*.db
*.sqlite
*.sqlite3
*.pidbak

# Node / Frontend
node_modules/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Local scratch space (run docs, commit-message drafts, one-off reproduction scripts).
# Never part of the product: nothing here is imported by the package or the frontend.
.freebuff/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Reasonix local session metadata
.reasonix/

# Generated exports
*.svg
*.png
*.dxf
*.pdf
# Test output: CI and the local acceptance runs write evidence here. The evidence worth keeping
# is copied to reports/ deliberately, so this directory stays scratch.
backend/test-results/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
!frontend/e2e/visual.spec.ts-snapshots/*.png
credentials*
